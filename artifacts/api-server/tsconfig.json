{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // El build real lo hace esbuild (build.mjs); tsc solo se usa para
    // typecheck (--noEmit). noEmit permite allowImportingTsExtensions, que a su
    // vez deja que los *.test.ts importen con extensión .ts (requisito del
    // runner nativo `node --test`).
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    },
    {
      "path": "../../lib/integrations-openai-ai-server"
    }
  ]
}
