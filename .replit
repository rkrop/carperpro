modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0", "twilio:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 22179
externalPort = 3003

[[ports]]
localPort = 26270
externalPort = 3000

[[ports]]
localPort = 26271
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]

[userenv.shared]
TWILIO_VERIFY_SERVICE_SID = "VA18ebfb97843782323728954c8c280dd0"
CARPER_NOTIFY_SMS_TO = "+526441225597"
PUBLIC_SITE_URL = "https://autopartescarper.com"
